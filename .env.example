# Copy to .env and fill in real values: cp .env.example .env
# NEVER commit .env. In AWS, these come from Secrets Manager instead.
APP_ENV=local
LOG_LEVEL=info

POSTGRES_USER=taskflow
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=taskflow
DATABASE_URL=postgresql+psycopg://taskflow:CHANGE_ME@localhost:5432/taskflow

JWT_SECRET=CHANGE_ME
